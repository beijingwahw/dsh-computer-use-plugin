{
  "name": "dsh-computer-use-plugin",
  "version": "1.0.0",
  "type": "module",
  "description": "Vision-only desktop automation plugin for DeepSeek Harness (fusion refactor)",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/fix-imports.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import ./test/register.mjs \"test/*.test.ts\"",
    "smoke": "node --import ./test/register.mjs scripts/smoke_imports.mjs",
    "verify": "python scripts/verify_fatal_fixes.py && python scripts/bug_class_lint.py --strict",
    "doctor": "node --disable-warning=ExperimentalWarning --import ./test/register.mjs src/doctorCli.ts",
    "bench": "node --test --import ./test/register.mjs \"test/*.bench.ts\""
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "undici": "^8.10.2"
  }
}