{
  "name": "dsh-computer-use-plugin",
  "version": "1.0.0",
  "type": "module",
  "description": "Vision-only desktop automation plugin for DeepSeek Harness (fusion refactor)",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20 <24"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "python_service",
    "!python_service/**/__pycache__",
    "!python_service/**/*.pyc",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/fix-imports.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import ./test/register.mjs \"test/*.test.ts\"",
    "smoke": "node --import ./test/register.mjs scripts/smoke_imports.mjs",
    "smoke:dist": "node scripts/smoke_dist.mjs",
    "verify": "python scripts/verify_fatal_fixes.py && python scripts/bug_class_lint.py --strict && npm run lint:cycle && npm run wiring:census && npm run audit:genesis",
    "lint:cycle": "node scripts/cycle_lint.mjs",
    "wiring:census": "node scripts/wiring_census.mjs --check",
    "audit:genesis": "node scripts/genesis_audit.mjs --check",
    "test:coverage": "node --test --experimental-test-coverage \"test/*.test.ts\" --import ./test/register.mjs",
    "manifest": "node scripts/build_manifest.mjs",
    "doctor": "node --disable-warning=ExperimentalWarning --import ./test/register.mjs src/doctorCli.ts",
    "bench": "node --test --import ./test/register.mjs \"test/*.bench.ts\""
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0",
    "undici": "^8.10.2"
  }
}